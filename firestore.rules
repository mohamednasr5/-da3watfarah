// ===================================
// 📋 قواعد أمان Firebase Firestore
// 🎯 مشروع: دعوة فرح - da3watfarah.com
// ===================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===================================
    // 📁 مجموعة المستخدمين (users)
    // ===================================
    match /users/{userId} {
      // المستخدم يمكن قراءة وكتابة بياناته فقط
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // دعوات المستخدم الفرعية
      match /invitations/{invitationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // RSVPs داخل دعوات المستخدم
        match /rsvps/{rsvpId} {
          allow read: if true;
          allow create: if request.auth != null || request.auth == null;
          allow update, delete: if request.auth != null;
        }
        
        // التهاني داخل دعوات المستخدم
        match /wishes/{wishId} {
          allow read: if true;
          allow create: if request.auth != null || request.auth == null;
          allow update, delete: if request.auth != null;
        }
      }
    }
    
    // ===================================
    // 💌 مجموعة الدعوات العامة (invitations)
    // ===================================
    match /invitations/{invitationId} {
      // الجميع يمكنهم قراءة الدعوات المنشورة
      allow read: if true;
      
      // إنشاء دعوة جديدة يتطلب تسجيل دخول
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && isValidInvitation(request.resource.data);
      
      // تحديث أو حذف الدعوة = صاحبها فقط
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && isValidInvitation(request.resource.data);
      
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      
      // ===================================
      // 📝 تأكيدات الحضور (RSVPs) - فرعية
      // ===================================
      match /rsvps/{rsvpId} {
        // القراءة عامة (لصاحب الدعوة والضيوف)
        allow read: if true;
        
        // أي شخص يمكنه إضافة تأكيد حضور (حتى بدون حساب)
        allow create: if isValidRsvp(request.resource.data);
        
        // التحديث والحذف للمصادقين فقط
        allow update: if request.auth != null;
        allow delete: if request.auth != null 
          || resource.data.guestEmail == request.auth.token.email;
      }
      
      // ===================================
      // 💬 التهاني (Wishes) - فرعية
      // ===================================
      match /wishes/{wishId} {
        // القراءة عامة
        allow read: if true;
        
        // أي شخص يمكنه إضافة تهنئة
        allow create: if isValidWish(request.resource.data);
        
        // التعديل والحذف للمالك أو المسؤول
        allow update: if request.auth != null;
        allow delete: if request.auth != null 
          || resource.data.authorEmail == request.auth.token.email;
      }
      
      // ===================================
      // 🖼️ صور المعرض (Gallery) - فرعي
      // ===================================
      match /gallery/{imageId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null 
          && get(/databases/$(database)/documents/invitations/$(invitationId)).data.userId == request.auth.uid;
      }
    }
    
    // ===================================
    // 🎨 مجموعة القوالب (templates) - للقراءة فقط
    // ===================================
    match /templates/{templateId} {
      // القوالب متاحة للقراءة للجميع
      allow read: if true;
      
      // الكتابة محظورة (للإدارة فقط عبر Firebase Console)
      allow write: if false; 
    }
    
    // ===================================
    // 💰 مجموعة الاشتراكات (subscriptions) - إذا استخدمت
    // ===================================
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null 
        && (request.auth.uid == resource.data.userId 
             || request.resource.data.userId == request.auth.uid);
    }
    
    // ===================================
    // 🔔 مجموعة الإشعارات (notifications) - إذا استخدمت
    // ===================================
    match /notifications/{notifId} {
      allow read: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      
      allow delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
  }
}

// ===================================
// ✅ دوال التحقق المساعدة (Helper Functions)
// ===================================

// التحقق من صحة بيانات الدعوة
function isValidInvitation(data) {
  return data.couple is map
    && data.couple.groomName is string
    && data.couple.groomName.size() > 1
    && data.couple.brideName is string
    && data.couple.brideName.size() > 1
    && data.event is map
    && data.event.date is timestamp
    && data.design is map
    && data.design.templateId is string
    && data.slug is string
    && data.slug.size() > 2;
}

// التحقق من صحة بيانات RSVP
function isValidRsvp(data) {
  return data.guestName is string
    && data.guestName.size() > 1
    && data.attendance in ['attending', 'not-attending', 'pending']
    && data.invitationId is string
    && data.guestCount is int
    && data.guestCount >= 0
    && data.guestCount <= 10;
}

// التحقق من صحة بيانات التهنئة
function isValidWish(data) {
  return data.authorName is string
    && data.authorName.size() > 1
    && data.message is string
    && data.message.size() > 0
    && data.message.size() <= 500
    && data.invitationId is string;
}
