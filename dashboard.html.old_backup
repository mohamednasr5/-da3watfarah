<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم | دعوة فرح</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&family=Amiri:wght@400;700&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/dashboard.css">
</head>
<body class="dashboard-body">
    <!-- Dashboard Container -->
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Logo -->
            <div class="sidebar-header">
                <a href="index.html" class="logo">
                    <span class="logo-icon">💍</span>
                    <span class="logo-text">دعوة<span class="gold">فرح</span></span>
                </a>
                <button class="sidebar-close" id="sidebarClose">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- User Info -->
            <div class="user-profile-mini">
                <div class="avatar-placeholder">
                    <i class="fas fa-user"></i>
                </div>
                <div class="user-info-text">
                    <h4 id="userName">أحمد & سارة</h4>
                    <span>خطة: بريميوم</span>
                </div>
            </div>

            <!-- Navigation Menu -->
            <nav class="sidebar-nav">
                <ul>
                    <li class="active">
                        <a href="#overview" data-section="overview">
                            <i class="fas fa-home"></i>
                            <span>نظرة عامة</span>
                        </a>
                    </li>
                    <li>
                        <a href="#create-invitation" data-section="create">
                            <i class="fas fa-plus-circle"></i>
                            <span>إنشاء دعوة جديدة</span>
                        </a>
                    </li>
                    <li>
                        <a href="#my-invitations" data-section="invitations">
                            <i class="fas fa-envelope-open-text"></i>
                            <span>دعواتي</span>
                        </a>
                    </li>
                    <li>
                        <a href="#gallery" data-section="gallery">
                            <i class="fas fa-images"></i>
                            <span>معرض الصور</span>
                        </a>
                    </li>
                    <li>
                        <a href="#music" data-section="music">
                            <i class="fas fa-music"></i>
                            <span>الموسيقى</span>
                        </a>
                    </li>
                    <li>
                        <a href="#ai-writer" data-section="ai">
                            <i class="fas fa-wand-magic-sparkles"></i>
                            <span>كاتب AI</span>
                        </a>
                    </li>
                    <li>
                        <a href="#settings" data-section="settings">
                            <i class="fas fa-cog"></i>
                            <span>الإعدادات</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Upgrade Card -->
            <div class="sidebar-upgrade">
                <div class="upgrade-icon">👑</div>
                <h4>ترقية لـ VIP</h4>
                <p>احصل على ميزات حصرية ومزيد من التخصيص</p>
                <a href="#" class="btn btn-sm btn-gold">ترقية الآن</a>
            </div>

            <!-- Logout Button -->
            <div class="sidebar-footer">
                <button onclick="logout()" class="btn-logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>تسجيل الخروج</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-right">
                    <button class="mobile-menu-btn" id="mobileSidebarBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title" id="pageTitle">نظرة عامة</h1>
                </div>
                
                <div class="header-left">
                    <!-- Search -->
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="بحث...">
                    </div>
                    
                    <!-- Notifications -->
                    <button class="header-btn notification-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">3</span>
                    </button>
                    
                    <!-- User Dropdown -->
                    <div class="user-dropdown">
                        <button class="user-btn">
                            <div class="user-avatar-small">
                                <i class="fas fa-user"></i>
                            </div>
                            <span class="user-name">أحمد & سارة</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu">
                            <a href="#profile"><i class="fas fa-user-edit"></i> الملف الشخصي</a>
                            <a href="#settings"><i class="fas fa-cog"></i> الإعدادات</a>
                            <hr>
                            <a href="#" onclick="logout()"><i class="fas fa-sign-out-alt"></i> تسجيل الخروج</a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content Sections -->
            <div class="content-wrapper">
                
                <!-- Overview Section -->
                <section class="dashboard-section active" id="overview">
                    <!-- Welcome Banner -->
                    <div class="welcome-banner">
                        <div class="welcome-content">
                            <h2>مرحباً بك، <span class="gold">أحمد وسارة!</span> 💕</h2>
                            <p>استمتع بإنشاء دعوة زفاف أحلامك. نحن هنا لمساعدتك في كل خطوة.</p>
                            <a href="#create-invitation" class="btn btn-primary" onclick="showSection('create')">
                                <i class="fas fa-plus"></i>
                                أنشئ دعوتك الآن
                            </a>
                        </div>
                        <div class="welcome-image">
                            <div class="floating-elements">
                                <span class="float-item ring">💍</span>
                                <span class="float-item heart">❤️</span>
                                <span class="float-item star">⭐</span>
                                <span class="float-item flower">🌸</span>
                            </div>
                        </div>
                    </div>

                    <!-- Stats Cards -->
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon blue">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="stat-details">
                                <h3>3</h3>
                                <p>الدعوات المنشأة</p>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon green">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-details">
                                <h3>156</h3>
                                <p>المشاهدات الإجمالية</p>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon gold">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stat-details">
                                <h3>42</h3>
                                <p>تأكيدات الحضور</p>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon purple">
                                <i class="fas fa-images"></i>
                            </div>
                            <div class="stat-details">
                                <h3>28</h3>
                                <p>الصور المرفوعة</p>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Invitations -->
                    <div class="recent-section">
                        <div class="section-header-row">
                            <h3><i class="fas fa-clock-rotate-left"></i> آخر الدعوات</h3>
                            <a href="#my-invitations" onclick="showSection('invitations')">عرض الكل</a>
                        </div>
                        
                        <div class="invitations-list">
                            <div class="invitation-card">
                                <div class="invitation-preview classic-preview-sm">
                                    <span>أ&س</span>
                                </div>
                                <div class="invitation-info">
                                    <h4>دعوة زفاف أحمد وسارة</h4>
                                    <p><i class="fas fa-link"></i> da3watfarah.com/ahmed-sara</p>
                                    <div class="invitation-stats">
                                        <span><i class="fas fa-eye"></i> 89 مشاهدة</span>
                                        <span><i class="fas fa-check"></i> 24 تأكيد</span>
                                    </div>
                                </div>
                                <div class="invitation-actions">
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-qrcode"></i></button>
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-share"></i></button>
                                </div>
                            </div>
                            
                            <div class="invitation-card">
                                <div class="invitation-preview modern-preview-sm">
                                    <span>م&ن</span>
                                </div>
                                <div class="invitation-info">
                                    <h4>دعوة حفلة الخطوبة</h4>
                                    <p><i class="fas fa-link"></i> da3watfarah.com/mohamed-noura</p>
                                    <div class="invitation-stats">
                                        <span><i class="fas fa-eye"></i> 45 مشاهدة</span>
                                        <span><i class="fas fa-check"></i> 12 تأكيد</span>
                                    </div>
                                </div>
                                <div class="invitation-actions">
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-qrcode"></i></button>
                                    <button class="btn btn-sm btn-outline"><i class="fas fa-share"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Create Invitation Section -->
                <section class="dashboard-section" id="create">
                    <div class="section-header-row">
                        <h3><i class="fas fa-plus-circle"></i> إنشاء دعوة جديدة</h3>
                    </div>

                    <!-- Create Wizard -->
                    <div class="create-wizard">
                        <!-- Wizard Steps -->
                        <div class="wizard-steps">
                            <div class="wiz-step active" data-step="1">
                                <div class="step-num">1</div>
                                <span>المعلومات الأساسية</span>
                            </div>
                            <div class="wiz-step-line"></div>
                            <div class="wiz-step" data-step="2">
                                <div class="step-num">2</div>
                                <span>تصميم الدعوة</span>
                            </div>
                            <div class="wiz-step-line"></div>
                            <div class="wiz-step" data-step="3">
                                <div class="step-num">3</div>
                                <span>المحتوى</span>
                            </div>
                            <div class="wiz-step-line"></div>
                            <div class="wiz-step" data-step="4">
                                <div class="step-num">4</div>
                                <span>النشر</span>
                            </div>
                        </div>

                        <!-- Step 1: Basic Info -->
                        <div class="wizard-content active" id="wizardStep1">
                            <form id="createFormStep1">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label for="groomNameCreate">اسم العريس *</label>
                                        <input type="text" id="groomNameCreate" placeholder="أدخل اسم العريس" required>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label for="brideNameCreate">اسم العروسة *</label>
                                        <input type="text" id="brideNameCreate" placeholder="أدخل اسم العروسة" required>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="weddingDate">تاريخ الزفاف *</label>
                                        <input type="date" id="weddingDate" required>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="weddingTime">وقت الحفل *</label>
                                        <input type="time" id="weddingTime" required>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="venueName">اسم القاعة / المكان *</label>
                                        <input type="text" id="venueName" placeholder="مثال: فندق الريتز كارلتون">
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="venueAddress">العنوان التفصيلي *</label>
                                        <textarea id="venueAddress" rows="2" placeholder="أدخل العنوان الكامل مع المدينة"></textarea>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="googleMapsLink">رابط Google Maps (اختياري)</label>
                                        <input type="url" id="googleMapsLink" placeholder="https://maps.google.com/...">
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="customSlug">رابط الدعوة المخصص *</label>
                                        <div class="slug-input">
                                            <span class="slug-prefix">da3watfarah.com/</span>
                                            <input type="text" id="customSlug" placeholder="ahmed-sara">
                                        </div>
                                        <small>استخدم حروف إنجليزية صغيرة واصلة (-) فقط</small>
                                    </div>
                                </div>
                                
                                <div class="wizard-buttons">
                                    <button type="button" class="btn btn-primary" onclick="nextWizardStep(2)">
                                        التالي: اختيار التصميم
                                        <i class="fas fa-arrow-left"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Step 2: Design Selection -->
                        <div class="wizard-content" id="wizardStep2">
                            <div class="template-selector">
                                <h4>اختر قالب الدعوة</h4>
                                
                                <div class="templates-grid-dashboard">
                                    <label class="template-option selected">
                                        <input type="radio" name="template" value="classic" checked>
                                        <div class="template-thumb classic-thumb">
                                            <span>كلاسيكي</span>
                                        </div>
                                        <span class="template-label">الكلاسيكي الذهبي</span>
                                    </label>
                                    
                                    <label class="template-option">
                                        <input type="radio" name="template" value="modern">
                                        <div class="template-thumb modern-thumb">
                                            <span>عصري</span>
                                        </div>
                                        <span class="template-label">العصري الأنيق</span>
                                    </label>
                                    
                                    <label class="template-option">
                                        <input type="radio" name="template" value="romantic">
                                        <div class="template-thumb romantic-thumb">
                                            <span>رومانسي</span>
                                        </div>
                                        <span class="template-label">الرومانسي الناعم</span>
                                    </label>
                                    
                                    <label class="template-option">
                                        <input type="radio" name="template" value="islamic">
                                        <div class="template-thumb islamic-thumb">
                                            <span>إسلامي</span>
                                        </div>
                                        <span class="template-label">الإسلامي الفاخر</span>
                                    </label>
                                    
                                    <label class="template-option">
                                        <input type="radio" name="template" value="bohemian">
                                        <div class="template-thumb bohemian-thumb">
                                            <span>بوهيمي</span>
                                        </div>
                                        <span class="template-label">البوهيمي الحر</span>
                                    </label>
                                    
                                    <label class="template-option">
                                        <input type="radio" name="template" value="royal">
                                        <div class="template-thumb royal-thumb">
                                            <span>ملكي</span>
                                        </div>
                                        <span class="template-label">الملكي الفاخر</span>
                                    </label>
                                </div>

                                <!-- Color Customization -->
                                <div class="color-customization">
                                    <h5><i class="fas fa-palette"></i> تخصيص الألوان</h5>
                                    <div class="color-options">
                                        <label class="color-option">
                                            <input type="radio" name="colorScheme" value="gold" checked>
                                            <div class="color-preview" style="background: linear-gradient(135deg, #D4AF37, #F4E4BC);"></div>
                                            <span>ذهبي</span>
                                        </label>
                                        
                                        <label class="color-option">
                                            <input type="radio" name="colorScheme" value="rose">
                                            <div class="color-preview" style="background: linear-gradient(135deg, #E8B4B8, #F8E8EA);"></div>
                                            <span>وردي</span>
                                        </label>
                                        
                                        <label class="color-option">
                                            <input type="radio" name="colorScheme" value="emerald">
                                            <div class="color-preview" style="background: linear-gradient(135deg, #10B981, #D1FAE5);"></div>
                                            <span>زمرد</span>
                                        </label>
                                        
                                        <label class="color-option">
                                            <input type="radio" name="colorScheme" value="navy">
                                            <div class="color-preview" style="background: linear-gradient(135deg, #1E3A5F, #3B5998);"></div>
                                            <span>كحلي</span>
                                        </label>
                                        
                                        <label class="color-option custom-color">
                                            <input type="radio" name="colorScheme" value="custom">
                                            <div class="color-preview custom">
                                                <i class="fas fa-plus"></i>
                                            </div>
                                            <span>مخصص</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="wizard-buttons">
                                <button type="button" class="btn btn-outline" onclick="nextWizardStep(1)">
                                    <i class="fas fa-arrow-right"></i>
                                    السابق
                                </button>
                                <button type="button" class="btn btn-primary" onclick="nextWizardStep(3)">
                                    التالي: المحتوى
                                    <i class="fas fa-arrow-left"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Step 3: Content -->
                        <div class="wizard-content" id="wizardStep3">
                            <div class="content-editor">
                                <!-- AI Writer Integration -->
                                <div class="ai-assistant-box">
                                    <div class="ai-header">
                                        <i class="fas fa-wand-magic-sparkles"></i>
                                        <span>مساعد الذكاء الاصطناعي</span>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="generateAIContent()">
                                            <i class="fas fa-sparkles"></i>
                                            اكتب لي نص احترافي
                                        </button>
                                    </div>
                                    <p class="ai-hint">دع AI يكتب لك نص دعوة احترافي ومؤثر بناءً على معلوماتك</p>
                                </div>

                                <div class="form-grid">
                                    <div class="form-group full-width">
                                        <label for="welcomeText">نص الترحيب / الآية الكريمة</label>
                                        <textarea id="welcomeText" rows="3" placeholder="بسم الله الرحمن الرحيم"></textarea>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="invitationText">نص الدعوة الرئيسي *</label>
                                        <textarea id="invitationText" rows="4" placeholder="يسرنا دعوتكم لحضور زفافنا..."></textarea>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="loveStory">قصتنا (اختياري)</label>
                                        <textarea id="loveStory" rows="4" placeholder="اكتب قصة تعارفكم..."></textarea>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="parentsNames">أسماء الوالدين (اختياري)</label>
                                        <input type="text" id="parentsNames" placeholder="الأب: ... الأم: ...">
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label>رفع صورة الغلاف *</label>
                                        <div class="upload-area" id="coverUpload">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                            <p>اسحب الصورة هنا أو <span>تصفح</span></p>
                                            <small>PNG, JPG حتى 5MB</small>
                                            <input type="file" accept="image/*" hidden>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label>رفع صور العروسين</label>
                                        <div class="upload-area multiple" id="couplePhotosUpload">
                                            <i class="fas fa-images"></i>
                                            <p>ارفع صوركم معاً (حتى 20 صورة)</p>
                                            <input type="file" accept="image/*" multiple hidden>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group full-width">
                                        <label for="bgMusic">الموسيقى الخلفية (اختياري)</label>
                                        <div class="music-upload">
                                            <input type="text" id="bgMusic" placeholder="رابط YouTube أو رفع ملف MP3">
                                            <button type="button" class="btn btn-sm btn-outline">
                                                <i class="fas fa-upload"></i>
                                                رفع
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="wizard-buttons">
                                <button type="button" class="btn btn-outline" onclick="nextWizardStep(2)">
                                    <i class="fas fa-arrow-right"></i>
                                    السابق
                                </button>
                                <button type="button" class="btn btn-primary" onclick="nextWizardStep(4)">
                                    التالي: المراجعة والنشر
                                    <i class="fas fa-arrow-left"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Step 4: Preview & Publish -->
                        <div class="wizard-content" id="wizardStep4">
                            <div class="preview-publish">
                                <div class="preview-header">
                                    <h4><i class="fas fa-eye"></i> معاينة الدعوة</h4>
                                    <div class="preview-actions">
                                        <button class="btn btn-sm btn-outline" onclick="openPreview()">
                                            <i class="fas fa-expand"></i>
                                            معاينة كاملة
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Mini Preview -->
                                <div class="mini-preview-frame">
                                    <div class="phone-frame-mini">
                                        <div class="preview-screen-mini" id="previewScreenMini">
                                            <!-- Dynamic preview content will be inserted here -->
                                            <div class="preview-placeholder">
                                                <i class="fas fa-mobile-alt"></i>
                                                <span>معاينة الدعوة</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Publish Options -->
                                <div class="publish-options">
                                    <h5><i class="fas fa-paper-plane"></i> خيارات النشر</h5>
                                    
                                    <div class="option-card">
                                        <label class="toggle-option">
                                            <input type="checkbox" id="publishNow" checked>
                                            <span class="toggle-switch-custom"></span>
                                            <div class="option-info">
                                                <strong>نشر فوري</strong>
                                                <p>اجعل الدعوة متاحة فوراً للضيوف</p>
                                            </div>
                                        </label>
                                    </div>
                                    
                                    <div class="option-card">
                                        <label class="toggle-option">
                                            <input type="checkbox" id="enableRSVP">
                                            <span class="toggle-switch-custom"></span>
                                            <div class="option-info">
                                                <strong>تفعيل RSVP</strong>
                                                <p>السماح للضيوف بتأكيد الحضور</p>
                                            </div>
                                        </label>
                                    </div>
                                    
                                    <div class="option-card">
                                        <label class="toggle-option">
                                            <input type="checkbox" id="enableCountdown" checked>
                                            <span class="toggle-switch-custom"></span>
                                            <div class="option-info">
                                                <strong>عداد تنازلي</strong>
                                                <p>عرض عداد تنازلي حتى موعد الزفاف</p>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <!-- Invitation URL -->
                                <div class="invitation-url-box">
                                    <h5><i class="fas fa-link"></i> رابط الدعوة</h5>
                                    <div class="url-display">
                                        <code id="finalInvitationUrl">da3watfarah.com/ahmed-sara</code>
                                        <button class="btn btn-sm btn-outline" onclick="copyInvitationUrl()">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                    </div>
                                    <div class="qr-code-preview" id="qrCodePreview">
                                        <!-- QR Code will be generated here -->
                                        <div class="qr-placeholder">
                                            <i class="fas fa-qrcode"></i>
                                            <span>QR Code</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="wizard-buttons final">
                                <button type="button" class="btn btn-outline" onclick="nextWizardStep(3)">
                                    <i class="fas fa-arrow-right"></i>
                                    السابق
                                </button>
                                <button type="button" class="btn btn-success btn-lg" onclick="publishInvitation()">
                                    <i class="fas fa-rocket"></i>
                                    نشر الدعوة الآن!
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Other Sections Placeholder -->
                <section class="dashboard-section" id="invitations">
                    <div class="section-header-row">
                        <h3><i class="fas fa-envelope-open-text"></i> دعواتي</h3>
                        <button class="btn btn-primary btn-sm" onclick="showSection('create')">
                            <i class="fas fa-plus"></i>
                            دعوة جديدة
                        </button>
                    </div>
                    
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h3>لا توجد دعوات بعد</h3>
                        <p>ابدأ بإنشاء أولى دعواتك الآن!</p>
                        <button class="btn btn-primary" onclick="showSection('create')">
                            إنشاء دعوة جديدة
                        </button>
                    </div>
                </section>

                <section class="dashboard-section" id="gallery">
                    <div class="section-header-row">
                        <h3><i class="fas fa-images"></i> معرض الصور</h3>
                    </div>
                    <div class="empty-state">
                        <i class="fas fa-images"></i>
                        <h3>لا توجد صور بعد</h3>
                        <p>قم برفع صورك عند إنشاء دعوة جديدة</p>
                    </div>
                </section>

                <section class="dashboard-section" id="music">
                    <div class="section-header-row">
                        <h3><i class="fas fa-music"></i> الموسيقى</h3>
                    </div>
                    <div class="empty-state">
                        <i class="fas fa-music"></i>
                        <h3>لا توجد ملفات صوتية</h3>
                        <p>أضف موسيقى خلفية لدعوتك</p>
                    </div>
                </section>

                <section class="dashboard-section" id="ai">
                    <div class="section-header-row">
                        <h3><i class="fas fa-wand-magic-sparkles"></i> كاتب AI</h3>
                    </div>
                    
                    <div class="ai-writer-section">
                        <div class="ai-writer-card">
                            <div class="ai-writer-header">
                                <div class="ai-icon-large">
                                    <i class="fas fa-robot"></i>
                                </div>
                                <div>
                                    <h3>مساعد كتابة الدعوات بالذكاء الاصطناعي</h3>
                                    <p>مدعوم بتقنية NVIDIA AI - اكتب دعوة احترافية في ثوانٍ</p>
                                </div>
                            </div>
                            
                            <form id="aiWriterForm">
                                <div class="form-group">
                                    <label>نوع النص المطلوب</label>
                                    <select id="aiTextType">
                                        <option value="invitation">نص دعوة رسمي</option>
                                        <option value="romantic">نص رومانسي عاطفي</option>
                                        <option value="islamic">نص إسلامي تقليدي</option>
                                        <option value="modern">نص عصري ومختصر</option>
                                        <option value="story">قصة حب قصيرة</option>
                                    </select>
                                </div>
                                
                                <div class="form-group">
                                    <label for="aiGroomName">اسم العريس</label>
                                    <input type="text" id="aiGroomName" placeholder="أحمد">
                                </div>
                                
                                <div class="form-group">
                                    <label for="aiBrideName">اسم العروسة</label>
                                    <input type="text" id="aiBrideName" placeholder="سارة">
                                </div>
                                
                                <div class="form-group">
                                    <label for="aiWeddingDate">تاريخ الزفاف</label>
                                    <input type="date" id="aiWeddingDate">
                                </div>
                                
                                <div class="form-group">
                                    <label for="aiVenue">مكان الحفل</label>
                                    <input type="text" id="aiVenue" placeholder="فندق الريتز كارلتون">
                                </div>
                                
                                <div class="form-group">
                                    <label for="aiExtraNotes">ملاحظات إضافية (اختياري)</label>
                                    <textarea id="aiExtraNotes" rows="3" placeholder="أي تفاصيل إضافية تريد إضافتها..."></textarea>
                                </div>
                                
                                <button type="submit" class="btn btn-primary btn-block btn-lg">
                                    <i class="fas fa-wand-magic-sparkles"></i>
                                    توليد النص بالذكاء الاصطناعي
                                </button>
                            </form>
                            
                            <div class="ai-result" id="aiResult" style="display: none;">
                                <h4><i class="fas fa-check-circle"></i> النص المولّد:</h4>
                                <div class="result-content" id="aiGeneratedText"></div>
                                <div class="result-actions">
                                    <button class="btn btn-primary btn-sm" onclick="copyAIText()">
                                        <i class="fas fa-copy"></i>
                                        نسخ النص
                                    </button>
                                    <button class="btn btn-outline btn-sm" onclick="useInInvitation()">
                                        <i class="fas fa-paste"></i>
                                        استخدم في الدعوة
                                    </button>
                                    <button class="btn btn-outline btn-sm" onclick="regenerateAI()">
                                        <i class="fas fa-redo"></i>
                                        إعادة التوليد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="dashboard-section" id="settings">
                    <div class="section-header-row">
                        <h3><i class="fas fa-cog"></i> الإعدادات</h3>
                    </div>
                    
                    <div class="settings-grid">
                        <div class="settings-card">
                            <h4><i class="fas fa-user-edit"></i> الملف الشخصي</h4>
                            <form class="settings-form">
                                <div class="form-group">
                                    <label>اسم العريس</label>
                                    <input type="text" value="أحمد">
                                </div>
                                <div class="form-group">
                                    <label>اسم العروسة</label>
                                    <input type="text" value="سارة">
                                </div>
                                <div class="form-group">
                                    <label>البريد الإلكتروني</label>
                                    <input type="email" value="ahmed@example.com" disabled>
                                </div>
                                <div class="form-group">
                                    <label>رقم الجوال</label>
                                    <input type="tel" value="0501234567">
                                </div>
                                <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
                            </form>
                        </div>
                        
                        <div class="settings-card">
                            <h4><i class="fas fa-lock"></i> الأمان</h4>
                            <form class="settings-form">
                                <div class="form-group">
                                    <label>كلمة المرور الحالية</label>
                                    <input type="password" placeholder="••••••••">
                                </div>
                                <div class="form-group">
                                    <label>كلمة المرور الجديدة</label>
                                    <input type="password" placeholder="••••••••">
                                </div>
                                <div class="form-group">
                                    <label>تأكيد كلمة المرور</label>
                                    <input type="password" placeholder="••••••••">
                                </div>
                                <button type="submit" class="btn btn-primary">تحديث كلمة المرور</button>
                            </form>
                        </div>
                        
                        <div class="settings-card">
                            <h4><i class="fas fa-bell"></i> الإشعارات</h4>
                            <div class="notification-settings">
                                <label class="toggle-option">
                                    <input type="checkbox" checked>
                                    <span class="toggle-switch-custom"></span>
                                    <span>إشعارات البريد الإلكتروني عند تأكيد الحضور</span>
                                </label>
                                <label class="toggle-option">
                                    <input type="checkbox" checked>
                                    <span class="toggle-switch-custom"></span>
                                    <span>تذكيرات أسبوعية بالإحصائيات</span>
                                </label>
                                <label class="toggle-option">
                                    <input type="checkbox">
                                    <span class="toggle-switch-custom"></span>
                                    <span>عروض وتخفيضات خاصة</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </main>
    </div>

    <!-- Firebase SDK (Realtime Database Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-storage-compat.js"></script>
    
    <!-- QR Code Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <!-- AOS Animation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    
    <!-- Dashboard JavaScript -->
    <script src="js/firebase-config.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/dashboard.js"></script>
</body>
</html>
