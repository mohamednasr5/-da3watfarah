{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "invitations": {
      "$slug": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",

        "rsvps": {
          ".read": "auth != null && (root.child('invitations').child($slug).child('ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
          "$rsvpId": {
            ".write": "!data.exists() && newData.hasChildren(['guestName','attending','createdAt'])"
          }
        },

        "wishes": {
          ".read": true,
          "$wishId": {
            ".write": "!data.exists() && newData.hasChildren(['name','message','createdAt'])"
          }
        },

        "gallery": {
          ".read": true,
          "$photoId": {
            ".write": "(!data.exists() && newData.hasChildren(['url','createdAt'])) || (auth != null && (root.child('invitations').child($slug).child('ownerUid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true))"
          }
        }
      }
    }
  }
}
