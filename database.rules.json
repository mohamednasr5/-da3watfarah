{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".validate": "newData.hasChildren(['email', 'createdAt'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length < 256"
        },
        "displayName": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "plan": {
          ".validate": "newData.isString() && (newData.val() === 'free' || newData.val() === 'premium' || newData.val() === 'vip')"
        },
        "invitations": {
          "$invitationId": {
            ".read": "$uid === auth.uid",
            ".write": "$uid === auth.uid",
            ".validate": "newData.hasChildren(['couple', 'event', 'design'])",
            "rsvps": {
              ".read": true,
              "$rsvpId": {
                ".write": true
              }
            },
            "wishes": {
              ".read": true,
              "$wishId": {
                ".write": true,
                ".validate": "newData.hasChildren(['authorName', 'message'])",
                "message": {
                  ".validate": "newData.isString() && newData.val().length <= 500"
                }
              }
            }
          }
        }
      }
    },
    "templates": {
      ".read": true,
      ".write": false,
      "$templateId": {
        ".validate": "newData.hasChildren(['id', 'nameAr', 'colors'])"
      }
    },
    "invitations": {
      ".read": true,
      "$invitationId": {
        ".write": "auth != null && (data.child('userId').val() === auth.uid || !data.exists())",
        ".validate": "newData.hasChildren(['userId', 'couple', 'event', 'design', 'slug'])",
        ".indexOn": ["userId", "slug", "status", "isPublished"],
        "userId": {
          ".validate": "newData.isString()"
        },
        "slug": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'draft' || newData.val() === 'active' || newData.val() === 'archived')"
        },
        "isPublished": {
          ".validate": "newData.isBoolean()"
        },
        "viewsCount": {
          ".write": true,
          ".validate": "newData.isNumber()"
        },
        "views": {
          ".write": true,
          ".validate": "newData.isNumber()"
        },
        "rsvps": {
          ".read": true,
          "$rsvpId": {
            ".write": true,
            ".validate": "newData.hasChildren(['guestName', 'attendance'])",
            "guestName": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "attendance": {
              ".validate": "newData.isString() && (newData.val() === 'attending' || newData.val() === 'not_attending' || newData.val() === 'pending')"
            }
          }
        },
        "wishes": {
          ".read": true,
          "$wishId": {
            ".write": true,
            ".validate": "newData.hasChildren(['authorName', 'message'])",
            ".indexOn": ["createdAt"],
            "authorName": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "message": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "isVisible": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },
    "public": {
      "$slug": {
        ".read": true,
        ".write": "auth != null",
        "stats": {
          "views": {
            ".write": true
          },
          "rsvps": {
            ".write": true
          }
        }
      }
    },
    "analytics": {
      ".write": false,
      ".read": "auth != null"
    },
    "settings": {
      ".write": false,
      ".read": "auth != null"
    }
  }
}
