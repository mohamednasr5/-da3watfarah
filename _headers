# ============================================================================
# ⚠️ NOT ACTIVE ON THIS SITE — kept only for reference.
#
# da3watfarah.com is served by GitHub Pages (see the CNAME file), with
# Cloudflare in front only for DNS/CDN. GitHub Pages does NOT read this
# `_headers` file at all — it's a Cloudflare Pages / Netlify convention.
# So the rules below currently do nothing.
#
# REAL FIX for the PageSpeed "no efficient cache TTL" warning on this
# hosting setup: go to the Cloudflare dashboard → Rules → Cache Rules,
# and add a rule for da3watfarah.com/css/*, /js/*, *.mp3, *.jpg, *.png
# setting Edge Cache TTL + Browser Cache TTL (e.g. 7 days for css/js,
# 30 days for images). That has to be done in the dashboard, not in a
# file in this repo.
#
# If the site is ever migrated to Cloudflare Pages instead of GitHub
# Pages, this file becomes active automatically and the rules below
# are the intended ones.
# ============================================================================

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

/*.mp3
  Cache-Control: public, max-age=604800, must-revalidate

/*.jpg
  Cache-Control: public, max-age=2592000, must-revalidate

/*.png
  Cache-Control: public, max-age=2592000, must-revalidate

/*.webp
  Cache-Control: public, max-age=2592000, must-revalidate

# Service worker must always be revalidated so PWA updates reach users.
/service-worker.js
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
